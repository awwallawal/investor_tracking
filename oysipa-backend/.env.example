# =============================================================================
# OYSIPA Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git. Only .env.example is tracked.
# =============================================================================

# --- Server ---
# Port the Express server runs on (default: 3001)
PORT=5000

# --- Database (Required) ---
# MongoDB connection string for development
# Local:  mongodb://localhost:27017/oysipa
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oysipa
MONGO_URI=mongodb://localhost:27017/oysipa

# MongoDB connection string for tests (optional, defaults to oysipa_test)
MONGO_URI_TEST=mongodb://localhost:27017/oysipa_test

# --- Authentication (Required) ---
# Secret key for signing JWT tokens. Use a strong random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_strong_random_string

# --- Seed Data (Optional) ---
# Credentials for the initial Director-General account created on first run.
# If not set, defaults to dg@oysipa.com / password123
ADMIN_EMAIL=dg@oysipa.com
ADMIN_PASSWORD=CHANGE_ME_in_production

# --- CORS (Required for production) ---
# Frontend URL allowed to make API requests
# Local development: http://localhost:5173
# Production: https://your-frontend-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Private document storage (story 11.4b) ---
# Uploads go through the backend to private storage. When these are missing,
# upload and "View" return 503 "Document storage is not configured".
# Never put real values in this file or in the frontend.
# Provider (default: cloudinary)
DOCUMENT_STORAGE=
# Max upload size in MB (default: 10)
DOCUMENT_MAX_MB=
# Cloudinary account (server env only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
