# =============================================================================
# OYSIPA Frontend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: All frontend env vars MUST be prefixed with VITE_ to be accessible.
# IMPORTANT: Never commit .env to git. Only .env.example is tracked.
# =============================================================================

# --- API Configuration ---
# Base URL for backend API requests.
#
# Local development: Leave empty or set to "/" — Vite proxy handles routing
# Production: Set to your deployed backend URL
#
# VITE_API_URL=/
